\begin{quote}
\textbf{A Cryptographic Primitives}
\end{quote}

\textbf{Definition A.1} (Encryption Scheme)\textbf{.} \emph{A public key
encryption scheme} E \emph{is a triple of PPT}

\begin{quote}
\emph{algorithms} (E\emph{.}Gen\emph{,} E\emph{.}Enc\emph{,}
E\emph{.}Dec) \emph{where}

\emph{•} E\emph{.}Gen(1\emph{n}) \emph{generates a secret/public key
pair} (sk\emph{,} pk)\emph{.}

\emph{•} E\emph{.}Encpk(\emph{m}) \emph{computes a ciphertext c.}

\emph{•} E\emph{.}Decsk(\emph{c}) \emph{computes the plaintext m, such
that} E\emph{.}Decsk(E\emph{.}Encpk(\emph{m})) = \emph{m.}

We use the standard chosen plaintest attack (CPA) game {[}GM84{]} to
model security:

\emph{•} The challenger generates (sk\emph{,} pk)
\emph{←}E\emph{.}Gen(1\emph{n}), and sends pk to the adversary \emph{A}.

\emph{• A} generates the challenge plaintext (\emph{m}0\emph{, m}1).

\emph{•} The challenger chooses a bit \emph{b}, and responds with the
challenge ciphertext \emph{c} = E\emph{.}Encpk(\emph{mb}).\emph{• A}
makes a guess \emph{b′}for \emph{b}.

The advantage of \emph{A} is \emph{ϵ}, where\uline{1 2}+ \emph{ϵ} is the
probability that \emph{b} = \emph{b′}. We say that E is (quantum)

IND-CPA-secure if all efficient (quantum) algorithms have only
negligible advantage (in \emph{n}).

An identity-based encryption (IBE) scheme IBE is an encryption scheme
where identities serve

as public keys, and a trusted authority hands out the corresponding
secret keys. In particular:
\end{quote}

\textbf{Definition A.2} (IBE Scheme)\textbf{.} \emph{An identity-based
encryption (IBE) scheme} IBE \emph{is a quadruple of}

\emph{PPT algorithms} (IBE\emph{.}Gen\emph{,} IBE\emph{.}Extract\emph{,}
IBE\emph{.}Enc\emph{,} IBE\emph{.}Dec) \emph{where}

\begin{quote}
\emph{•} IBE\emph{.}Gen(1\emph{n}) \emph{generates a master
secret/public key pair} (msk\emph{,} mpk)\emph{.}\\
\emph{• The trusted authority uses} IBE\emph{.}Extractmsk(id) \emph{to
compute a secret key} skid \emph{corresponding to the identity}
id\emph{.}

\emph{•} IBE\emph{.}Encmpk(id\emph{, m}) \emph{encrypts m to identity}
id\emph{.}\\
\emph{•} IBE\emph{.}Decskid(\emph{c}) \emph{decrypts c, such that}
\end{quote}

IBE\emph{.}DecIBE\emph{.}Extractmsk(id)(IBE\emph{.}Encmpk(id\emph{, m}))
= \emph{m}

\begin{quote}
We use the standard CPA attack game for IBE schemes, where the adversary
can choose the
\end{quote}

identity id for which it will attempt to decrypt, and can get the secret
keys corresponding to any

\begin{quote}
other identities {[}BF01{]}. Specifically,

\emph{•} The challenger generates (msk\emph{,} mpk)
\emph{←}IBE\emph{.}Gen(1\emph{n}), and sends mpk to the adversary
\emph{A}.\emph{•} The adversary can make extraction queries on
identities id\emph{i}, to which the challenger responds with
IBE\emph{.}Extractmsk(id\emph{i}).

\emph{•} The adversary generates an identity id, and two messages
(\emph{m}0\emph{, m}1).\emph{•} The challenger chooses a random bit
\emph{b}, and responds with IBE\emph{.}Encid(\emph{mb}).\emph{• A} makes
a guess \emph{b′}for \emph{b}.
\end{quote}

that IBE is (quantum) IND-ID-CPA-secure if all efficient (quantum)
algorithms have only negligible The advantage of \emph{A} is \emph{ϵ},
where\uline{1 2}+ \emph{ϵ} is the probability that id \emph{̸}=
id\emph{i} for any \emph{i} and \emph{b} = \emph{b′}. We say

\begin{quote}
advantage (in \emph{n}).
\end{quote}

17

\begin{quote}
\textbf{Definition A.3} (Signature Scheme)\textbf{.} \emph{A signature
scheme} S \emph{is a triple of PPT algorithms}
\end{quote}

(S\emph{.}Gen\emph{,} S\emph{.}Sign\emph{,} S\emph{.}Ver) \emph{where}

\begin{quote}
\emph{•} S\emph{.}Gen(1\emph{n}) \emph{generates a secret/public key
pair} (sk\emph{,} pk)\emph{.}

\emph{•} S\emph{.}Signsk(\emph{m}) \emph{computes a signature σ on the
message m.}

\emph{•} S\emph{.}Verpk(\emph{m, σ}) \emph{outputs} accept \emph{or}
reject\emph{, such that} S\emph{.}Verpk(\emph{m,}
S\emph{.}Signsk(\emph{m})) = accept\emph{.}
\end{quote}

We will use the standard chosen message attack (CMA) game to define
security {[}GMR88{]}:

\begin{quote}
\emph{•} The challenger generates (sk\emph{,} pk)
\emph{←}S\emph{.}Gen(1\emph{n}), and sends pk to the adversary
\emph{A}.\\
\emph{• A} can make signature queries on messages \emph{mi}, to which
the challenger responds with S\emph{.}Signsk(\emph{mi}).

\emph{• A} produces a forgery candidate (\emph{m, σ}).
\end{quote}

that S is (quantum) UF-CMA-secure if all efficient (quantum) adversaries
have negligible advantage The advantage of \emph{A} is the probability
that \emph{m ̸}= \emph{mi} for any \emph{i} and Verpk(\emph{m, σ}) =
accept. We say

(in \emph{n}).

\begin{quote}
\textbf{Definition A.4} (PSF)\textbf{.} \emph{A pre-image sampleable
function (PSF) is a quadruple of algorithms}

F = (F\emph{.}Gen\emph{,} F\emph{.}Sample\emph{, f, f−}1) \emph{where:}

\emph{•} F\emph{.}Gen(1\emph{n}) \emph{generates a secret/public key
pair} (sk\emph{,} pk)\emph{.}

\emph{• f}pk \emph{is a function.}

\emph{•} F\emph{.}Sample \emph{samples x from a distribution D such that
f}pk(\emph{x}) \emph{is uniform.• f−}1 sk(\emph{y}) \emph{samples from D
conditioned on f}pk(\emph{x}) = \emph{y.}

We model security with the following game:

\emph{•} The challenger generates (sk\emph{,} pk)
\emph{←}F\emph{.}Gen(1\emph{n}), and sends pk to the adversary \emph{A}.
It also sends \emph{y} = \emph{f}pk(F\emph{.}Sample()) to \emph{A}.

\emph{• A} makes a guess \emph{x}.

The advantage of \emph{A} is the probability that \emph{f}pk(\emph{x}) =
\emph{y}. We say that F is (quantum) one-way if

all efficient (quantum) algorithms have negligible advantage.

A trapdoor permutation (TDP) is a special case of a PSF where \emph{f}
is bijective and F\emph{.}Sample
\end{quote}

simply returns a random element in the domain of \emph{f}pk. Since
F\emph{.}Sample is already defined, we omit

\begin{quote}
it from the specification.

\textbf{B Quantum Computation}
\end{quote}

We give some background on quantum computation. For a more thorough
discussion, please see

{[}NC00{]}. We also prove Theorem 3.1, which states that the output
distribution of a quantum

algorithm making \emph{qH} queries to a quantum oracle drawn from some
distribution \emph{D} depends only on

\begin{quote}
the marginal distributions of \emph{D} on all subsets of 2\emph{q}
inputs.

Let \emph{H} be a Hilbert space with an inner product
\emph{⟨·\textbar·⟩}, and let \emph{B} = \emph{\{\textbar x⟩\}} be an
orthonormal basis for \emph{H}, index by a parameter \emph{x ∈X}. The
state of a quantum system on \emph{H} is specified by a vector
\emph{\textbar φ⟩∈H} of norm 1.
\end{quote}

18

\begin{quote}
\textbf{Quantum Measurement} Given a state \emph{\textbar φ⟩}, we can
measure \emph{\textbar φ⟩}in the basis \emph{B}, obtaining the value
\emph{x ∈X} with probability \emph{\textbar⟨x\textbar φ⟩\textbar{}}2.
Thus, to each \emph{\textbar φ⟩}, we associate a distribution \emph{Dφ}
where \emph{Dφ}(\emph{x}) = \emph{\textbar⟨x\textbar φ⟩\textbar{}}2. The
normalization constant and the fact that \emph{B} is an orthonormal
basis ensure that this is in fact a valid distribution. After
measurement, the system is in state \emph{\textbar x⟩}.

If \emph{B} = \emph{\{\textbar x, y⟩\}} for \emph{x ∈X} and \emph{y ∈Y},
then we can also perform a partial measurement over \emph{X}.
\end{quote}

\emph{y∈Y\textbar⟨x, y\textbar φ⟩\textbar{}}2. The resulting state is
the result of projecting \emph{\textbar φ⟩}to The distribution over
\emph{X} is the marginal distribution of \emph{Dφ} when restricted to
\emph{X}. That is, we obtain the value \emph{x} with probability\\
the space spanned by \emph{\{\textbar x, y⟩\}} for \emph{y ∈Y}, and
renormalizing so that the norm is 1.

\begin{quote}
\textbf{Quantum Algorithms} A quantum algorithm \emph{A} over a Hilbert
space \emph{H} with an orthonormal basis \emph{B} is specified by
unitary transformation \emph{U}. The input to \emph{A} is an element
\emph{x}0 \emph{∈X}. The system is initialized to the basis state
\emph{\textbar x}0\emph{⟩}, and \emph{U} is applied to the system,
obtaining the final state \emph{\textbar φ⟩}=
\emph{U\textbar x}0\emph{⟩}. Then the state is sampled according to the
distribution \emph{Dφ}.

Let \emph{X} and \emph{Y} be sets such that \emph{Y} is a commutative
group with addition operation \emph{⊕}. For notational convenience, we
assume that every element has order at most 2 (\emph{y ⊕y} is the
identity for all \emph{y ∈Y}). Given a function \emph{H} : \emph{X →Y}
and third set \emph{Z}, define the orthonormal basis \emph{B} as the set
\emph{\{\textbar x, y, z⟩\}} for \emph{x ∈X}, \emph{y ∈Y}, and \emph{z
∈Z}. Define the unitary transformation \emph{H}trans over the Hilbert
space spanned by \emph{B} as the transformation that takes
\emph{\textbar x, y, z⟩}into \emph{\textbar x, y ⊕H}(\emph{x})\emph{,
z⟩}. \emph{H}trans is unitary, it's own inverse, and Hermitian. As an
abuse of notation, we will frequently use \emph{H}trans

and \emph{H} interchangeably.

A quantum algorithm \emph{A} making \emph{q} quantum queries to \emph{H}
is then specified by a sequence of
\end{quote}

unitary transformations \emph{U}0\emph{, ..., Uq}. The evaluation of
\emph{A} then consists of alternately applying \emph{Ui} and

\begin{quote}
\emph{H} to the initial state \emph{\textbar x⟩}. We call
\end{quote}

